.DS_Store
**/.DS_Store
*.swp

# Node
node_modules/

# Hook runtime artifacts
*.log
*.state

# ...but archived experiment transcripts are EVIDENCE, not runtime artifacts. This
# negation exists because `*.log` above silently dropped a 344KB rescued transcript that
# a backfill phase was about to read — the copy succeeded, `git add` reported nothing, and
# the only surviving copy was still in `/tmp`. Archived logs are append-only history and
# must be committed by name.
!alfred/eval/archive/**/*.log

# User-specific harness config (machine-local: repo registry, telemetry sink)
harness-core/config/user.json

# Local harness run artifacts (self-hosting: this repo is also a harness target)
.harness/

# Probe run outputs (delivered to harness-telemetry, never committed here)
harness-core/probes/*/results/

# Alfred's PER-RUN worker markers. Named individually, NOT as `.alfred/`, because
# `.alfred/config.json` is tracked and `alfred work` refuses without it — ignoring the
# directory would work here (git honours a tracked file) and break on a fresh clone.
#
# Committed, these are worse than absent: `resolveAcs` would run a predecessor's commands
# and report passes, a false green sourced from a stale file. Untracked, `collectDiff`
# (`ls-files --others --exclude-standard`) attributes them to whoever runs next. Ignoring
# fixes both — `--exclude-standard` skips ignored files.
.alfred/ac-map.json
.alfred/blocked.json
