#!/usr/bin/env node
// The entrypoint. A shebang and a call — every decision lives in lib/cli.mjs so that the
// refusals are importable and can be watched failing. §1: one script with subcommands, so the
// slash command and cron reach the same code path.
//
// `process.exitCode` rather than `process.exit()`: exit() truncates pending writes on a pipe,
// which loses exactly the verdict line a scheduler is reading.
import { main } from '../lib/cli.mjs';

process.exitCode = await main(process.argv.slice(2));
