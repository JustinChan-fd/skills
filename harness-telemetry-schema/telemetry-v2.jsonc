// harness-telemetry — v2 record schema (schemaVersion: "2.0")
// Source of truth: ~/Desktop/Repos/skills/harness-telemetry-schema/telemetry-v2.jsonc
// Written by: writeAuditRecord() in harness-{intake,plan,implement}/workflow.js
// Stored at:  ~/Desktop/Repos/harness-telemetry/v2/
// Effective 2026-07-25. One JSONL line per run, appended to harness-telemetry/v2/.
//
// Field provenance vocabulary:
//   [observed]  — value comes directly from the runtime/API; no transformation
//   [derived]   — arithmetic on other observed fields in this same record
//   [snapshot]  — computed against an external reference (e.g. price table) that changes over time;
//                 tokens are always the ground truth — dollars can be recomputed from tokens later
//
// Null policy: a field may be null when its data source was unavailable at write time.
// The cost.nullReasons map records WHY each null field is null.
//
// Append-only rule: no code path may update or rewrite a past record.
// The post-Workflow SKILL.md patch rewrites the last line of the current run's file BEFORE
// the run is considered complete — this is the single allowed exception, not a retroactive edit.
{
  // ── Identity ────────────────────────────────────────────────────────────────

  "schemaVersion": "2.0",
  // [observed] Always "2.0" for records written by this implementation.

  "runId": "TARS-1271-20260725T083102Z",
  // [observed] Cross-skill linkage key: ${issueKey}-${runTs}.
  // Shared across intake → plan → implement so all three records join to one logical run.
  // Generated by SKILL.md wrapper before Workflow() fires.

  "skill": "harness-intake",
  // [observed] Which skill wrote this record: "harness-intake" | "harness-plan" | "harness-implement".

  "skillsSchemaVersion": "1",
  // [observed] Internal version of the skills repo schema contract. Incremented on breaking changes.

  "skillsCommit": "62c1cd0a...",
  // [observed] Git SHA of the skills repo at run time (captured by SKILL.md wrapper via git rev-parse).
  // Allows correlating a record with the exact skill code that produced it.

  "emitTrigger": "workflow",
  // [observed] Always "workflow" — the record is written by the workflow's Debrief step.
  // Would be "hook" if a SessionEnd backstop fired instead (not yet implemented).

  "billingMode": "api",
  // [observed] Hardcoded "api" — subscription-mode dollar figures are notional; tokens are exact regardless.

  // ── Run context ─────────────────────────────────────────────────────────────

  "ts": "2026-07-25",
  // [observed] Calendar date of the run (injected as currentDate by Claude Code session).
  // NOTE: full ISO 8601 timestamp_start / timestamp_end are a known gap vs the spec — not yet implemented.

  "status": "COMPLETE",
  // [observed] Terminal status of the run: COMPLETE | PROPOSED_WITH_GAPS | PARTIAL | CRASHED | FAILED.

  "outcome": "success",
  // [derived] Human-readable outcome derived from status: "success" | "partial" | "failed".

  "sourceIssue": "TARS-1271",
  // [observed] Jira issue key extracted from the input URL or plan path. "unknown" if not resolvable.

  "repo": "tars-app",
  // [observed] Last path segment of repoPath. Identifies which codebase this run touched.

  "repoPath": "/Users/.../Desktop/Repos/tars-app",
  // [observed] Absolute path to the repo on disk at run time.

  "durationMs": 183420,
  // [derived] Wall-clock run time in milliseconds.
  // Computed by SKILL.md wrapper: endTs (after Workflow() returns) − startTs (before Workflow() fires).
  // Null if the workflow crashed before the wrapper could patch this field.

  "size": null,
  // [observed] T-shirt size of the work: "XS" | "S" | "M" | "L" | null.
  // KNOWN GAP: always null — the size is computed inside the workflow but not yet returned to the wrapper.

  // ── Token counts ─────────────────────────────────────────────────────────────
  // Tokens are the ground truth. Dollars are always recomputable from tokens + a price table.
  // All token counts are for the entire run (all subagents combined).

  "tokens": {
    "byModel": {
      "claude-haiku-4-5-20251001": { "output": null },
      "claude-sonnet-4-6":         { "output": null }
      // [observed] Model IDs present in agentCount.byModel. Per-model output counts are null —
      // budget.spent() exposes only the total output, not a per-model split.
      // Per-model input is not exposed by the runtime at all.
    },
    "total": {
      "input": 147832,
      // [derived] = tokens.total.subagentTokens − tokens.total.output.
      // Null if subagentTokens was unavailable (workflow crash before SKILL.md patch ran).

      "output": 52108,
      // [observed] From budget.spent() delta inside the workflow (end − start of run).
      // This is the authoritative output token count.

      "subagentTokens": 199940,
      // [observed] Combined input+output token count for all subagents.
      // Sourced from the <usage.subagent_tokens> field in the Workflow completion notification.
      // Read by the SKILL.md wrapper from context and patched into the record after Workflow() returns.
      // Null if the wrapper did not execute (crash) or the human did not supply the value.

      "cacheRead": null,
      // [observed] Null — the runtime does not expose cache read token counts in this mode (Mode B).

      "cacheCreation": null
      // [observed] Null — the runtime does not expose cache creation token counts in this mode (Mode B).
    }
  },

  // ── Agent counts ──────────────────────────────────────────────────────────────

  "agentCount": {
    "byModel": {
      "claude-haiku-4-5-20251001": 20,
      "claude-sonnet-4-6": 6
    },
    // [observed] Count of agent() calls that completed, keyed by model ID.
    // Used for blended-rate cost computation (by count, not by tokens — see cost.nullReasons).

    "byPhase": {
      "Intake": 3,
      "Research": 14,
      "Debrief": 3
    }
    // [observed] Count of agent() calls per workflow phase label.
  },

  // ── Cost ──────────────────────────────────────────────────────────────────────
  // rateLockedUsd is a snapshot: it reflects rates at write time (priceTableVersion).
  // If Anthropic changes pricing, historical records stay accurate to what was charged.
  // To recompute with new rates: use tokens.total.input + tokens.total.output + new price table.

  "cost": {
    "rateLockedUsd": 0.0312,
    // [snapshot] Cost ceiling computed from tokens × blended list-price rates at write time.
    // Actual charge is lower when prompt caching applies (cache reads bill at ~10% of input rate)
    // but cache hit counts are not exposed in Mode B — so this is always an upper bound.
    // Formula: ((inputTokens/1e6) × blendedInRate) + ((outputTokens/1e6) × blendedOutRate)
    // blendedInRate  = Σ(inRate(model)  × agentCount[model]) / totalAgents
    // blendedOutRate = Σ(outRate(model) × agentCount[model]) / totalAgents
    // Rates sourced from lib/cost.js (COST_RATES), versioned by priceTableVersion.
    // KNOWN LIMITATION: blending is by agent count, not by tokens — systematic undercount
    // on Sonnet-heavy runs where Sonnet agents process more tokens than Haiku agents.
    // Null if agentCountByModel was empty (see nullReasons).

    "priceTableVersion": "2026-07-25",
    // [observed] Version tag of the price table used for this calculation (lib/cost.js).
    // Allows historical records to be re-priced if rates change — change the table, recompute.

    "nullReasons": {}
    // [observed] Map of JSON path → reason string for any null fields in this cost object.
    // Example: { "cost.rateLockedUsd": "no agentCountByModel" }
    // An empty object means all cost fields were successfully computed.
  },

  // ── Skill-specific fields (vary by skill) ────────────────────────────────────

  // harness-intake adds:
  "intakeManifestPath": "docs/plans/2026-07-25-TARS-1271-intake-manifest.json",
  "size_from_intake": "S",
  "splitRequired": false,

  // harness-plan adds:
  "planSlug": "TARS-1271",
  "planCount": 1,
  "taskCount": 8,
  "qualityIssues": [],
  "architectRevisions": 1,
  "coverageRounds": 1,

  // harness-implement adds:
  "planPath": "docs/plans/2026-07-25-TARS-1271-p1.json",
  "planKey": "TARS-1271-p1",
  "branch": "harness/TARS-1271-implement",
  "baseBranch": "main",
  "tasksTotal": 8,
  "tasksPassed": 8,
  "tasksBlocked": 0,
  "criticalFindings": 0,
  "testsPassed": true,
  "typeCheckPassed": true
}
