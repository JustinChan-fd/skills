{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-observability/skill-run.schema.json",
  "title": "Skill run snapshot",
  "description": "One observability record per skill run (or per turn with SKILL_OBS_LOG_ALL=1). `raw` holds verbatim material copied from the hook payload and transcripts; `computed` holds every derived value. The two never mix: a consumer that wants ground truth reads raw, a dashboard reads computed, and computed can always be re-derived from raw (cost via pricing_version).",
  "type": "object",
  "required": ["schema_version", "logged_at", "run", "raw", "computed"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string" },
    "logged_at": { "type": "string", "format": "date-time" },
    "run": {
      "type": "object",
      "required": ["session_id", "trigger_event", "skills", "window"],
      "properties": {
        "run_id": { "type": ["string", "null"], "description": "Deterministic per-record id: <session8>-<line_from>-<line_to>. The join key for subagent_runs.spawned_by_run_id (see KPIs.md)" },
        "session_id": { "type": ["string", "null"] },
        "trigger_event": { "type": ["string", "null"], "description": "Stop | StopFailure | SessionEnd" },
        "cwd": { "type": ["string", "null"] },
        "transcript_path": { "type": ["string", "null"] },
        "skills": { "type": "array", "items": { "type": "string" }, "description": "Distinct skill/command names detected in the window" },
        "window": {
          "type": "object",
          "properties": {
            "line_from": { "type": "integer" },
            "line_to": { "type": "integer" },
            "transcript_lines_total": { "type": "integer" }
          }
        },
        "environment": {
          "type": "object",
          "properties": {
            "claude_code_version": { "type": ["string", "null"] },
            "git_branch": { "type": ["string", "null"] },
            "entrypoint": { "type": ["string", "null"] },
            "platform": { "type": "string" },
            "node": { "type": "string" }
          }
        }
      }
    },
    "raw": {
      "type": "object",
      "description": "Verbatim, untransformed material. usage_entries[].usage is the exact message.usage object from the transcript line, including per-TTL cache_creation split, service_tier, speed, server_tool_use, and iterations.",
      "required": ["hook_payload", "invocations", "usage_entries", "subagents"],
      "properties": {
        "hook_payload": { "type": ["object", "null"], "description": "The stdin JSON the hook received, verbatim" },
        "invocations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "name"],
            "properties": {
              "kind": { "enum": ["slash_command", "skill_tool"] },
              "name": { "type": ["string", "null"] },
              "args": { "type": ["string", "null"] },
              "line_index": { "type": "integer" },
              "uuid": { "type": ["string", "null"] },
              "timestamp": { "type": ["string", "null"] },
              "tool_use_id": { "type": ["string", "null"] }
            }
          }
        },
        "usage_entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "usage"],
            "properties": {
              "source": { "type": "string", "description": "\"session\" or \"subagent:<file>\"" },
              "line_index": { "type": "integer" },
              "model": { "type": ["string", "null"] },
              "stop_reason": {},
              "usage": { "type": "object", "description": "Verbatim message.usage" },
              "uuid": { "type": "string" },
              "parentUuid": { "type": ["string", "null"] },
              "requestId": { "type": "string" },
              "sessionId": { "type": "string" },
              "timestamp": { "type": "string" },
              "isSidechain": { "type": "boolean" },
              "entrypoint": { "type": "string" },
              "gitBranch": { "type": "string" },
              "version": { "type": "string" },
              "effort": { "type": "string" }
            }
          }
        },
        "subagents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": { "type": "string" },
              "meta": { "type": ["object", "null"], "description": "agent-<id>.meta.json verbatim (agentType, description, spawnDepth, toolUseId)" },
              "lines_from": { "type": "integer" },
              "lines_to": { "type": "integer" },
              "usage_entries": { "$ref": "#/properties/raw/properties/usage_entries" }
            }
          }
        },
        "dispatch_results": { "type": "array", "description": "toolUseResult objects from Agent/Task dispatches, verbatim" },
        "tool_calls": { "type": "array", "description": "tool_use names/ids/timestamps in the window (no inputs/outputs)" }
      }
    },
    "computed": {
      "type": "object",
      "description": "Derived values only. Everything here is re-derivable from raw.",
      "required": ["outcome", "tokens", "cost", "duration", "counts"],
      "properties": {
        "outcome": {
          "type": "object",
          "properties": {
            "trigger_event": { "type": ["string", "null"] },
            "session_end_reason": { "type": ["string", "null"] },
            "error_type": { "type": ["string", "null"] },
            "interrupted_tool_seen": { "type": "boolean" }
          }
        },
        "tokens": {
          "type": "object",
          "properties": {
            "by_model": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "input": { "type": "number" },
                  "output": { "type": "number" },
                  "cache_read": { "type": "number" },
                  "cache_creation_5m": { "type": "number" },
                  "cache_creation_1h": { "type": "number" },
                  "cache_creation_unattributed": { "type": "number" },
                  "api_calls": { "type": "number" }
                }
              }
            },
            "totals": { "type": "object" },
            "grand_total": { "type": "number" },
            "boundary_total": { "type": ["number", "null"], "description": "Final-turn four-way sum over top-level session usage — the dispatch-boundary quantity per docs/specs/2026-07-31-token-measurement-contract.md" },
            "counting_policy": { "type": "string" }
          }
        },
        "cost": {
          "type": "object",
          "properties": {
            "by_model": { "type": "object", "description": "Per model: { usd, marginal_usd, context_carry_usd, rates } — rates carry the exact prices used, incl. variant (standard/fast/introductory)" },
            "total_usd": { "type": ["number", "null"], "description": "marginal_usd + context_carry_usd; null when any model in the window has no pricing entry" },
            "marginal_usd": { "type": ["number", "null"], "description": "Cost of input + output + cache writes — spend the run itself caused. The skill-efficiency number; comparable across session depths (METRICS.md)" },
            "context_carry_usd": { "type": ["number", "null"], "description": "Cost of cache reads — the session-depth tax of running mid-session" },
            "known_models_usd": { "type": "number" },
            "complete": { "type": "boolean" },
            "pricing_version": { "type": "string" },
            "cache_multipliers": { "type": "object" },
            "split_policy": { "type": "string" }
          }
        },
        "duration": {
          "type": "object",
          "properties": {
            "started_at": { "type": ["string", "null"] },
            "ended_at": { "type": ["string", "null"] },
            "wall_ms": { "type": "number" },
            "active_ms": { "type": "number", "description": "Gap-capped: idle stretches longer than gap_cap_ms count as gap_cap_ms" },
            "gap_cap_ms": { "type": "number" }
          }
        },
        "counts": {
          "type": "object",
          "properties": {
            "api_calls": { "type": "number" },
            "assistant_usage_lines": { "type": "number" },
            "tool_calls": { "type": "number" },
            "tool_calls_by_name": { "type": "object" },
            "subagents": { "type": "number" },
            "subagent_tokens_grand_total": { "type": "number" },
            "invocations": { "type": "number" }
          }
        },
        "subagent_runs": {
          "type": "array",
          "description": "The subagent join table (derived; raw.subagents stays verbatim). One row per agent with new activity in this window.",
          "items": {
            "type": "object",
            "properties": {
              "file": { "type": "string", "description": "agent-<id>.jsonl — stable per agent across records" },
              "agent_type": { "type": ["string", "null"] },
              "tool_use_id": { "type": ["string", "null"], "description": "Joins to the Agent/Task call in the spawning record's raw.tool_calls / raw.dispatch_results" },
              "spawned_by_run_id": { "type": ["string", "null"], "description": "run_id of the record whose window first saw this agent; null = spawned in an unlogged turn" },
              "spawned_this_run": { "type": "boolean" },
              "lines_from": { "type": "integer" },
              "lines_to": { "type": "integer" },
              "tokens_grand_total": { "type": "number" },
              "cost_usd": { "type": ["number", "null"] },
              "models": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "detail"],
            "properties": { "code": { "type": "string" }, "detail": { "type": "string" } }
          }
        }
      }
    }
  }
}
