{
  "$id": "brief",
  "type": "object",
  "required": ["objective", "output", "tools", "boundaries", "done_when", "tier", "reasoning"],
  "additionalProperties": false,
  "properties": {
    "objective": { "type": "string" },
    "output": {
      "type": "object",
      "required": ["path", "schema"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "schema": { "type": ["string", "null"] }
      }
    },
    "tools": {
      "type": "object",
      "required": ["allowed", "forbidden"],
      "additionalProperties": false,
      "properties": {
        "allowed": { "type": "array", "items": { "type": "string" } },
        "forbidden": { "type": "array", "items": { "type": "string" } }
      }
    },
    "boundaries": { "type": "array", "items": { "type": "string" } },
    "done_when": { "type": "string" },
    "tier": {
      "type": "object",
      "required": ["level", "model"],
      "additionalProperties": false,
      "properties": {
        "level": { "enum": ["LOW", "MID", "HIGH"] },
        "model": { "enum": ["haiku", "sonnet", "opus"] }
      }
    },
    "reasoning": {
      "type": "object",
      "required": ["budget"],
      "additionalProperties": false,
      "properties": {
        "budget": { "enum": ["MINIMAL", "MODERATE", "FULL"] },
        "needs_decision_directive": { "type": ["string", "null"] }
      }
    },
    "schema_version": { "type": "string", "const": "1.0.0" }
  }
}
