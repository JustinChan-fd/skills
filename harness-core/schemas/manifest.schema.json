{
  "$id": "manifest",
  "type": "object",
  "required": ["run_id", "source", "requirement", "size", "schema_version"],
  "additionalProperties": false,
  "properties": {
    "run_id": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["type", "ref"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["issue", "file", "adhoc"] },
        "ref": { "type": "string" },
        "excerpt": { "type": ["string", "null"] }
      }
    },
    "requirement": {
      "type": "object",
      "required": ["summary", "acceptance_criteria"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string" },
        "details": { "type": ["string", "null"] },
        "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
        "change_type": { "enum": ["feat", "fix", "docs", "ci", "chore", "refactor", "perf", "test", null] }
      }
    },
    "size": {
      "type": "object",
      "required": ["value", "rationale"],
      "additionalProperties": false,
      "properties": {
        "value": { "enum": ["S", "M", "L"] },
        "rationale": { "type": "string" }
      }
    },
    "repo_scan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stack": { "type": ["string", "null"] },
        "key_paths": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": ["string", "null"] }
      }
    },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "claims_audit": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "verdict"],
        "additionalProperties": false,
        "properties": {
          "claim": { "type": "string" },
          "verdict": { "enum": ["verified", "corrected", "unverifiable"] },
          "evidence": { "type": ["string", "null"] }
        }
      }
    },
    "schema_version": { "type": "string", "const": "1.0.0" }
  }
}
