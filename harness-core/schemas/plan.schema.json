{
  "$id": "plan",
  "type": "object",
  "required": ["run_id", "units", "order", "schema_version"],
  "additionalProperties": false,
  "properties": {
    "run_id": { "type": "string" },
    "plan_key": { "type": ["string", "null"] },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "locations", "done_criteria"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "locations": { "type": "array", "items": { "type": "string" } },
          "done_criteria": { "type": "array", "items": { "type": "string" } },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "block": { "enum": ["parallel", "sequential", null] },
          "group_id": { "type": ["string", "null"] },
          "tdd_required": { "type": "boolean" }
        }
      }
    },
    "order": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": ["string", "null"] },
    "schema_version": { "type": "string", "const": "1.0.0" }
  }
}
