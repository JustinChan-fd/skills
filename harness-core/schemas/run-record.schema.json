{
  "$id": "run-record",
  "type": "object",
  "required": ["run_id", "repo", "machine", "kind", "input_type", "status", "phases", "started_at", "schema_version"],
  "additionalProperties": false,
  "properties": {
    "run_id": { "type": "string" },
    "parent_run_id": { "type": ["string", "null"] },
    "correlation_id": { "type": ["string", "null"] },
    "repo": { "type": "string" },
    "repo_path": { "type": ["string", "null"] },
    "branch": { "type": ["string", "null"] },
    "issue": { "type": ["string", "null"] },
    "machine": { "type": "string" },
    "harness_sha": { "type": ["string", "null"] },
    "skills_commit": { "type": ["string", "null"] },
    "kind": { "enum": ["intake", "plan", "implement", "pipeline"] },
    "input_type": { "enum": ["issue", "file", "adhoc"] },
    "size": { "enum": ["XS", "S", "M", "L", null] },
    "status": { "enum": ["attempted", "succeeded", "failed", "partial", "cancelled", "timeout", "abandoned"] },
    "reason": {
      "type": ["object", "null"],
      "required": ["code", "detail"],
      "properties": {
        "code": { "enum": ["verifier_blocking_cap", "cost_ceiling", "watchdog_stall", "user_cancelled", "needs_decision_unresolved", "subagent_budget_exhausted", "logging_unavailable", "crash", "bridge_confidence_low", "bridge_remediation_cap"] },
        "detail": { "type": "string" },
        "phase": { "type": ["string", "null"] },
        "agent": { "type": ["string", "null"] }
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["phase", "status"],
        "additionalProperties": false,
        "properties": {
          "phase": { "enum": ["intake", "plan", "implement"] },
          "status": { "enum": ["succeeded", "failed", "partial", "cancelled", "timeout", "abandoned"] },
          "rounds_used": { "type": ["integer", "null"] },
          "verifier_score": { "type": ["number", "null"] },
          "reason": { "type": ["object", "null"] },
          "ended_at": { "type": ["string", "null"] },
          "wall_ms": { "type": ["number", "null"] }
        }
      }
    },
    "tokens_by_tier": { "type": "object" },
    "tokens_directional": {
      "type": ["object", "null"],
      "required": ["by_model", "format_version", "collected_at", "complete"],
      "additionalProperties": false,
      "properties": {
        "by_model": { "type": "object" },
        "format_version": { "type": "string" },
        "collected_at": { "type": ["string", "null"] },
        "complete": { "type": "boolean" }
      }
    },
    "tokens_observed": {
      "type": ["object", "null"],
      "required": ["total", "tier", "source", "observed_at"],
      "additionalProperties": false,
      "properties": {
        "total": { "type": "number" },
        "tier": { "enum": ["LOW", "MID", "HIGH"] },
        "source": { "type": "string" },
        "observed_at": { "type": "string" }
      }
    },
    "routing_policy": { "type": ["string", "null"] },
    "wall_ms": { "type": ["number", "null"] },
    "active_ms": { "type": ["number", "null"] },
    "agent_count": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "by_model": { "type": "object" },
        "by_phase": { "type": "object" }
      }
    },
    "skill_metrics": { "type": ["object", "null"] },
    "emit_trigger": { "enum": ["workflow", "sweep", null] },
    "billing_mode": { "enum": ["api", "subscription", "unknown", null] },
    "price_table_version": { "type": ["string", "null"] },
    "started_at": { "type": "string" },
    "ended_at": { "type": ["string", "null"] },
    "synced_at": { "type": ["string", "null"] },
    "schema_version": { "enum": ["1.0.0", "1.1.0", "1.2.0", "1.3.0", "1.4.0", "1.5.0", "2.0.0"] }
  }
}
