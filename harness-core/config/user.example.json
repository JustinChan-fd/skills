{
  "repos": {
    "example-jira-repo": { "path": "~/path/to/your/repo", "issue_source": "jira" },
    "example-github-repo": { "path": "~/path/to/another/repo", "issue_source": "github", "github": "your-user/your-repo" }
  },
  "defaultRepo": "example-jira-repo",
  "billing_mode": "subscription",
  "telemetry": {
    "repo": "your-user/harness-telemetry",
    "remote": "git@github.com:your-user/harness-telemetry.git",
    "dir": "~/.harness/telemetry",
    "build": "node dashboard/build.mjs",
    "commit_identity": { "name": "harness", "email": "harness@example.com" }
  }
}
